{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "check": "svelte-check --workspace resources/js --no-tsconfig",
        "lint": "biome check resources/js/app.js src/core/laravel.js vite.config.js",
        "format": "biome format --write resources/js/app.js src/core/laravel.js vite.config.js"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "lucide": "^0.460.0",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.11.0",
        "svelte": "^5.57.3"
    }
}
